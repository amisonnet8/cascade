func makeAdder(base: int): func(int): int {
    return func(n: int): int {
        return base + n
    }
}

func makeCounter(): func(): int {
    let count = 0
    return func(): int {
        count += 1
        return count
    }
}

func applyTwice(f: func(int): int, x: int): int {
    return f(f(x))
}

// カリー化: クロージャーリテラルの中にさらにクロージャーリテラルを書ける
// (amivmのCLOSがネスト可能になったことで対応。&L-Nという階層付きトーク
// ンにより、内側のクロージャーから外側のクロージャーの引数(この場合は
// 外側のa)を正しく捕捉できる)
func curry(): func(int): func(int): int {
    return func(a: int): func(int): int {
        return func(b: int): int {
            return a + b
        }
    }
}

func main(): int {
    let add5 = makeAdder(5)
    print("add5(10)=" + string(add5(10)))

    let counter = makeCounter()
    print("counter()=" + string(counter()))
    print("counter()=" + string(counter()))
    print("counter()=" + string(counter()))

    print("applyTwice(add5, 1)=" + string(applyTwice(add5, 1)))

    let numbers: []int = [1, 2, 3, 4, 5, 6]

    let evens: []int = filter(numbers, func(n: int): bool {
        return n % 2 == 0
    })
    let evensTotal = 0
    for e in evens {
        evensTotal += e
    }
    print("evensTotal=" + string(evensTotal))

    let doubled: []int = map(numbers, func(n: int): int {
        return n * 2
    })
    let doubledTotal = 0
    for d in doubled {
        doubledTotal += d
    }
    print("doubledTotal=" + string(doubledTotal))

    let total: int = reduce(numbers, 0, func(acc: int, n: int): int {
        return acc + n
    })
    print("total=" + string(total))

    let add = curry()
    let addFive = add(5)
    print("curry()(5)(10)=" + string(addFive(10)))

    return 0
}
