func main(): int {
    let a = 3
    let b = 4

    let sum = a + b
    let product = a * b
    let remainder = product % 5
    print("sum: " + string(sum) + ", product: " + string(product) + ", remainder: " + string(remainder))

    let isBig = sum > 5
    let isEqual = a == 3
    print("isBig: " + string(isBig) + ", isEqual: " + string(isEqual))

    let name = "Cascade"
    let greeting = "Hello, " + name + "!"
    print(greeting)

    let ready = true
    let done = false
    print("ready && !done: " + string(ready && !done))
    print("ready || done: " + string(ready || done))

    return 0
}
