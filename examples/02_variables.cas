func main(): int {
    let greeting: string = "Hello, Cascade!"
    print(greeting)

    let name: string? = "Cascade"
    name = none

    const version: string = "0.1.0"
    print(version)

    let count = 3
    let pi: float = 3.14
    let ready: bool = true
    let empty: int?

    // 文字列リテラルのエスケープシーケンス(3.1節、AMIVM/Go準拠)
    print("she said \"hi\" to me")
    print("line1\nline2")
    print("emoji: \U0001F600")

    // 整数リテラルの基数・桁区切り(3.2節、AMIVM/Go準拠)
    let hex: int = 0x1A
    let oct: int = 0o17
    let bin: int = 0b101
    let million: int = 1_000_000
    print(string(hex) + " " + string(oct) + " " + string(bin) + " " + string(million))

    return 0
}
